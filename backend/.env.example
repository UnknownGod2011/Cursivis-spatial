# Copy to backend/.env for local development. Never commit real values.
PORT=8787

# One or more Gemini API keys (comma, space or newline separated). The pool rotates between them.
GEMINI_API_KEYS=

# Client tokens accepted in the x-cursivis-token header (comma separated).
# The Quest build embeds one of these; rotate by adding a new token, shipping, then removing the old one.
CURSIVIS_APP_TOKENS=

# Optional model overrides (comma separated, first = preferred, rest = fallbacks).
CURSIVIS_MODELS_FAST=
CURSIVIS_MODELS_QUALITY=
CURSIVIS_MODELS_TTS=
CURSIVIS_TTS_VOICE=

# Optional abuse/expense limits.
CURSIVIS_RATE_LIMIT_PER_MINUTE=
CURSIVIS_DAILY_REQUEST_CAP=
CURSIVIS_MAX_IMAGE_BYTES=
CURSIVIS_MAX_AUDIO_BYTES=

# Set to 1 to log per-request timing lines (never logs content or keys).
CURSIVIS_LOG_REQUESTS=1
