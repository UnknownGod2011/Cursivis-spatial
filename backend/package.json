{
  "name": "cursivis-spatial-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cursivis Spatial reasoning backend: contextual suggestions, action execution, contextual Talk and read-aloud for the Meta Quest client.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:live": "node --test --test-concurrency=1 \"tests/live/*.test.js\"",
    "fixtures": "node tools/make-fixtures.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "express": "^5.1.0"
  }
}
